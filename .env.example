# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в git

# Tinkoff Invest API
TINKOFF_TOKEN=your_sandbox_token_here
TINKOFF_ACCOUNT_ID=your_account_id_here
TINKOFF_SANDBOX=true           # true = песочница (сделки не реальные), false = боевой режим
TINKOFF_POST_ORDER_RATE=15     # лимит PostOrder (заявок/сек), актуально с февраля 2025
TINKOFF_GRPC_KEEPALIVE_TIMEOUT_MS=20000  # таймаут gRPC keepalive (мс); увеличить при нестабильном соединении

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432             # стандартный порт PostgreSQL
POSTGRES_DB=we_trust_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Настройки приложения
LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR
DEBUG=false

# Сбор рыночных данных
DATA_TICKERS=SBER,GAZP,LKOH,YDEX,NVTK,GMKN,MGNT,TATN,ROSN,MTSS  # тикеры через запятую
DATA_CANDLE_INTERVAL=1h        # 1min / 5min / 15min / 1h / 1d / 1w
DATA_HISTORY_DAYS=365          # глубина истории (дней), используется если DATA_START_DATE пустая
DATA_START_DATE=               # фиксированная дата начала истории (YYYY-MM-DD), пустая = использовать DATA_HISTORY_DAYS
DATA_USDRUB_FIGI=BBG0013HGFT4  # FIGI инструмента USD/RUB (USDRUB_TOM на MOEX)
DATA_COLLECT_PAUSE_SECONDS=15  # пауза между тикерами (сек), увеличить при RESOURCE_EXHAUSTED

# ML pipeline
ML_MODEL_VERSION=v2            # суффикс файлов весов: ensemble_v2.pkl, best_params_*_v2.json
ML_LOOKAHEAD=4                 # на сколько свечей вперёд смотрим для генерации меток (при 1h = 4 часа)
ML_THRESHOLD=0.005             # порог доходности ±0.5% для BUY/SELL; 0.01 давало 70% HOLD → F1≈0.33
ML_N_SPLITS=5                  # фолдов TimeSeriesSplit при кросс-валидации
ML_RANDOM_STATE=42             # seed для воспроизводимости результатов
ML_THRESHOLD_N_TRIALS=50       # итераций Optuna для подбора порога уверенности per-ticker
ML_SHARPE_MIN_TRADES=10        # минимум сделок для расчёта Sharpe ratio (меньше — штраф 0.0)
ML_OPTUNA_TRIALS_LGBM=25       # итераций подбора гиперпараметров LightGBM (кешируется после первого запуска)
ML_OPTUNA_TRIALS_XGB=25        # итераций подбора гиперпараметров XGBoost
ML_OPTUNA_TRIALS_ET=15         # итераций подбора гиперпараметров ExtraTrees
ML_OPTUNA_TRIALS_SVC=20        # итераций подбора SVC (медленнее из-за Platt scaling — держать <= 20)
ML_OPTUNA_TRIALS_CATBOOST=30   # итераций подбора гиперпараметров CatBoost (кешируется после первого запуска)
ML_MIN_CANDLES_PREDICT=250     # минимум свечей для инференса (50 прогрев + 200 буфер)
ML_FORCE_TUNE=false            # true — принудительный повтор Optuna (игнорировать кеш best_params_*.json). Вернуть в false после запуска!
ML_MODEL_CACHE_SIZE=1          # макс. число моделей в RAM одновременно (LRU). 1 = ~100MB вместо 1.1GB
ML_FEATURE_IMPORTANCE_THRESHOLD=0.01  # удалять признаки с importance < порога для каждого тикера; 0.0 = отключить
ML_PRINT_FEATURE_IMPORTANCE=false     # true — выводить таблицу важности признаков после обучения (для ручного анализа)

# Redis cache
REDIS_HOST=localhost           # хост Redis-сервера
REDIS_PORT=6379                # порт Redis
REDIS_DB=0                     # номер базы данных Redis (0-15)
REDIS_PASSWORD=                # пароль (оставить пустым если без аутентификации)
REDIS_SIGNAL_TTL=60            # TTL кеша сигнала BUY/SELL/HOLD (секунды)
REDIS_CANDLES_TTL=300          # TTL кеша свечей из PostgreSQL (секунды)
REDIS_PORTFOLIO_TTL=60         # TTL кеша сводки портфеля из Tinkoff API (секунды)
REDIS_PRICE_TTL=30             # TTL кеша последних цен инструментов (секунды)
REDIS_DIVIDEND_TTL=86400       # TTL кеша дивидендных данных (секунды, 86400 = 24 часа)

# Anthropic API (3-агентная система: Coder / Reviewer / Architect)
ANTHROPIC_API_KEY=sk-ant-...   # ключ API Anthropic (получить на console.anthropic.com)
AGENT_MODEL=claude-opus-4-6    # модель для всех трёх агентов
AGENT_MAX_REVISIONS=2          # максимум раундов ревизии кода (Coder → Reviewer → Coder)

# Автоматическая торговля
TRADING_ENABLED=false                # true — включить автоторговлю (ОСТОРОЖНО!)
TRADING_CONFIDENCE_THRESHOLD=0.65   # минимальная уверенность модели для открытия позиции (0.0 - 1.0)
TRADING_LOTS_PER_TICKER=1            # количество лотов на каждую сделку
TRADING_STOP_LOSS_PCT=0.01           # стоп-лосс: закрыть при убытке 1% от цены входа
TRADING_TAKE_PROFIT_PCT=0.01         # тейк-профит: закрыть при прибыли 1% от цены входа
TRADING_MAX_POSITIONS=5              # максимум одновременно открытых позиций
TRADING_INTERVAL_SECONDS=3600        # интервал проверки сигналов (секунды, 3600 = 1 час)
TRADING_CHAT_ID=                     # Telegram chat_id для уведомлений о сделках (пусто = отключить)
TRADING_BROKER_COMMISSION_PCT=0.003  # комиссия брокера+биржи за сделку (0.003 = 0.3%, взимается при покупке и продаже)
TRADING_TAX_PCT=0.13                 # ставка НДФЛ на прибыль от продажи (0.13 = 13%, 0.15 = 15% при доходе >5 млн/год)
TRADING_DIVIDEND_PROTECTION_DAYS=1  # защита SL от дивидендного гэпа: корректировать порог в экс-дивидендный день (0 = отключить)
TRADING_DIVIDEND_OVERRIDE=          # ручное окно защиты для конкретных тикеров: SBER:45,GAZP:90 (пусто = только авто-расчёт)
TRADING_VOLUME_MIN_RATIO=1.0        # фильтр объёма для BUY: volume_ratio >= порога; 1.0 = отключён; 1.3 = объём на 30% выше среднего
TRADING_ORDER_POLL_SECONDS=30       # интервал polling SL стоп-ордеров в OrderWatcher (секунды)
TRADING_CANDLE_UPDATE_PAUSE_SECONDS=3  # пауза между тикерами при внутрисессионном обновлении свечей (секунды)

# Ночное дообучение ML-моделей (инкрементальное — каждую ночь, HPO из кеша)
RETRAIN_ENABLED=true               # true — включить ночное дообучение
RETRAIN_HOUR=2                     # час запуска (0–23, по RETRAIN_TIMEZONE)
RETRAIN_MINUTE=0                   # минута запуска (0–59)
RETRAIN_TIMEZONE=Europe/Moscow     # часовой пояс (IANA: Europe/Moscow, UTC, Asia/Yekaterinburg)
RETRAIN_FORCE_TUNE=false           # true — перезапустить Optuna HPO при дообучении (занимает часы, не рекомендуется)
RETRAIN_CATCHUP_HOURS=8            # наверстывание: запустить сразу если бот стартовал не позднее N часов после RETRAIN_HOUR
