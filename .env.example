# Copy this file to .env and fill in real values
# NEVER commit .env to git

# Tinkoff Invest API
TINKOFF_TOKEN=your_sandbox_token_here
TINKOFF_ACCOUNT_ID=your_account_id_here
TINKOFF_SANDBOX=true  # true for sandbox, false for production

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=we_trust_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# App settings
LOG_LEVEL=INFO
DEBUG=false

# Data collection
DATA_TICKERS=SBER,GAZP,LKOH,YDEX,NVTK,GMKN,MGNT,TATN,ROSN,MTSS
DATA_CANDLE_INTERVAL=1h
DATA_HISTORY_DAYS=365

# ML pipeline
ML_MODEL_VERSION=v2
ML_LOOKAHEAD=4
ML_THRESHOLD=0.01
ML_N_SPLITS=5
ML_RANDOM_STATE=42
ML_OPTUNA_TRIALS_LGBM=50
ML_OPTUNA_TRIALS_XGB=50
ML_OPTUNA_TRIALS_RF=30
ML_MIN_CANDLES_PREDICT=250
